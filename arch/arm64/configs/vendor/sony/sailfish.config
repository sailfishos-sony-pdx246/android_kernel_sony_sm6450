#
# Sailfish OS (libhybris) additions, merged after gki_defconfig,
# vendor/parrot_GKI.config and vendor/sony/columbia.config.

# mer-kernel-check ERRORs: droid-hal's build runs the checker and stops on them
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_VT=y
# No console on the virtual terminals: the phone has no framebuffer console, and
# with VT_CONSOLE (and so VT_CONSOLE_SLEEP) the kernel switched to tty63 at every
# suspend attempt and back after it, which made logind flip the seat0 session and,
# through obexd and bluez, mce hold mce_bluez_wait for 2 s after every wake.
# mer-kernel-check only requires the VT option itself.
# CONFIG_VT_CONSOLE is not set
# CONFIG_STATIC_USERMODEHELPER is not set
# CONFIG_DUMMY is not set
CONFIG_QUOTA_NETLINK_INTERFACE=y
CONFIG_INET_AH=y
CONFIG_INET6_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_L2TP_V3=y
CONFIG_L2TP_IP=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_SYNC_TTY=y
CONFIG_PPP_FILTER=y
CONFIG_PPP_MULTILINK=y
CONFIG_PPPOE=y

# Needed although the checker only warns (or does not check): bluebinder creates
# the bluez HCI through /dev/vhci; mce suspends through /sys/power/autosleep,
# without it the phone never sleeps
CONFIG_BT_HCIVHCI=y
CONFIG_PM_AUTOSLEEP=y

# Recommended: systemd 238, bluez, connman
CONFIG_AUTOFS4_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_FANOTIFY=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CUSE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_IP_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_AH=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_IP6_NF_MATCH_MH=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_DCCP=y
CONFIG_NETFILTER_XT_MATCH_SCTP=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NETFILTER_XT_MATCH_NFACCT=y
CONFIG_NET_DROP_MONITOR=y
